{
  "expo": {
    "name": "UNPROV",
    "slug": "unprov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unprov",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.unprov.app"
    },
    "android": {
      "package": "com.unprov.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "UNPROV necesita acceso a tus fotos para que subas la imagen de tus productos.",
          "cameraPermission": "UNPROV necesita la cámara para fotografiar tus productos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UNPROV usa tu ubicación para llenar automáticamente tu dirección de entrega."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UNPROV usa Face ID para confirmar tus pagos con tarjeta."
        }
      ],
      "expo-notifications",
      "expo-audio",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
